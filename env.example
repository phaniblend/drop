# DropshipOS — copy to .env.local.

# Optional hosted DB (Turso / libSQL). Defaults to local file data/dropshipos.db
# DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_AUTH_TOKEN=

# Google Sign-In (first Google account claims this one-operator desk; no separate register)
# Cloud Console → APIs & Services → Credentials → Create OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# Shopify Admin API (Dev Dashboard app: client credentials grant)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional leftover from legacy custom apps
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# App ID + Secret (App settings → Basic) — used to extend short-lived tokens to ~60 days
META_APP_ID=
META_APP_SECRET=

# TikTok Marketing API
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# AliExpress Dropshipper Open API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# CJ Dropshipping Open API (optional second catalog in Discover)
# https://developers.cjdropshipping.com — create an API key in the CJ app
CJ_API_KEY=

# SerpApi (Google Lens visual match)
SERPAPI_KEY=

# Google Gemini (AI copy + ad angles). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default gemini-2.5-flash — 2.0-flash was shut down 2026-06-01)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Playwright is already used as a fallback when AliExpress HTML is blocked.
# ENABLE_HEADLESS_SCRAPE=false

# Protect cron + webhook endpoints in production
CRON_SECRET=
# GET /api/cron/margin-guard?secret=... every 15m
# GET /api/cron/hourly?secret=... at minute 0 (dayparting 1:00–6:00 store time)

# Meta Ad Library (competitor creatives). Same token can work if the app has ads_archive.
# META_ACCESS_TOKEN is reused.

# Stripe billing (Try 5 Free → Starter $19 / Scaler $39)
# APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SCALER=
