# DropshipOS — copy to .env.local / Railway.

# --- Required for login ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL=https://www.seto.store
# AUTH_TRUST_HOST=true
APP_URL=https://www.seto.store

# --- Shopify (Settings → Connect Shopify) ---
# Required for OAuth Connect. Redirect URI: {APP_URL}/api/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional scopes override
# SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory
# Optional fallback without OAuth
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Meta (Settings → Meta ads / Ads & Guard) ---
# Token alone = Needs setup until META_AD_ACCOUNT_ID works with a live /act_ call
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# App settings → Basic — Extend Meta token (~60 days) in Settings
META_APP_ID=
META_APP_SECRET=

# --- TikTok (optional; Settings → TikTok) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- AliExpress (optional enrich; Discover HTML works without) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# --- CJ Dropshipping (optional; Settings → CJ) ---
CJ_API_KEY=

# --- SerpApi visual match (optional; Discover) ---
SERPAPI_KEY=

# --- Gemini listing copy + ad angles (optional; Settings → Listing copy) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Cron (required in prod) ---
CRON_SECRET=
# GET /api/cron/hourly  Authorization: Bearer $CRON_SECRET
# GET /api/cron/margin-guard

# --- Billing (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SCALER=

# --- DB (optional; default local SQLite file) ---
# DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_AUTH_TOKEN=
